# ─────────────────────────────────────────────────────────────────────────────
# WiFi Pose Intelligence Platform — environment configuration
# Copy to `.env` for local dev. Every value below has a safe default, so the
# stack boots with ZERO secrets (offline LLM fallback + synthetic data).
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
WIFIPOSE_ENV=development                 # development | production
WIFIPOSE_LOG_LEVEL=INFO
WIFIPOSE_LOG_JSON=false                   # true => structured JSON logs (prod)

# --- Model / inference ---
WIFIPOSE_MODEL_PATH=checkpoints/wifipose.onnx
WIFIPOSE_SEQ_LEN=30
WIFIPOSE_NUM_FEATURES=104                 # 52 subcarriers x (amplitude + phase)
WIFIPOSE_ONNX_THREADS=1                   # intra-op threads; 1 is best for many tiny requests

# --- Database ---
# Local docker-compose default below. For free cloud, paste a Supabase/Neon URL.
# Use the asyncpg driver scheme:  postgresql+asyncpg://USER:PASS@HOST:PORT/DB
WIFIPOSE_DATABASE_URL=postgresql+asyncpg://wifipose:wifipose@localhost:5432/wifipose
WIFIPOSE_DB_ENABLE_TIMESCALE=true         # auto-degrades to false if extension missing

# --- Redis (cache + streams) ---
# Local docker-compose default. For free cloud, paste an Upstash rediss:// URL.
WIFIPOSE_REDIS_URL=redis://localhost:6379/0
WIFIPOSE_STREAM_KEY=csi:frames            # Redis Stream the producer writes to
WIFIPOSE_CONSUMER_GROUP=inference
WIFIPOSE_PREDICTION_CACHE_TTL=30          # seconds; dedupes identical CSI windows

# --- LLM provider ---
# provider: offline | gemini | groq | anthropic | openai
# `offline` needs no key: deterministic rule-based NL->SQL + extractive summaries.
WIFIPOSE_LLM_PROVIDER=offline
WIFIPOSE_LLM_MODEL=                        # blank => provider default (see providers.py)
WIFIPOSE_LLM_API_KEY=                      # paste your Gemini/Groq/etc key here
WIFIPOSE_LLM_TIMEOUT=20

# --- Demo / ingest ---
WIFIPOSE_PRODUCER_RATE_HZ=10              # synthetic frames per second
WIFIPOSE_PRODUCER_SUBJECTS=3              # concurrent simulated people

# --- CORS (frontend origin) ---
WIFIPOSE_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
